{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexiqon.dev/schemas/config/agent.json",
  "title": "Agent",
  "description": "An assistant built from a Domain Pack plus tenant choices.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack",
    "display_name"
  ],
  "properties": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Pin a pack version; default: the version deployed in the environment"
        }
      }
    },
    "display_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "model_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "retrieval_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "retention_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
      }
    },
    "tools_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write_confirmation": {
          "enum": [
            "always",
            "never"
          ]
        }
      }
    },
    "behaviour": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_name": {
          "type": "string",
          "maxLength": 100,
          "description": "What the assistant supports (fills {{product_name}} in pack prompts)"
        },
        "tone": {
          "enum": [
            "neutral",
            "friendly",
            "formal",
            "concise"
          ]
        },
        "language": {
          "type": "string",
          "description": "'auto' or a locale"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_evidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "x-ui": {
            "advanced": true
          }
        },
        "max_answer_tokens": {
          "type": "integer",
          "minimum": 50,
          "maximum": 8000,
          "x-ui": {
            "advanced": true
          }
        },
        "pii_redaction": {
          "type": "boolean"
        },
        "cite_sources": {
          "type": "boolean"
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_low_evidence": {
          "type": "boolean"
        },
        "on_user_request": {
          "type": "boolean"
        },
        "after_failed_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "handoff_tool": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
      }
    },
    "graph_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "nodes",
        "edges"
      ],
      "description": "Declarative agent workflow built from the node library (compiled to LangGraph).",
      "properties": {
        "entry": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "type": {
                "enum": [
                  "route",
                  "retrieve",
                  "classify",
                  "call_tool",
                  "clarify",
                  "validate_evidence",
                  "approve",
                  "escalate",
                  "respond"
                ]
              },
              "config": {
                "type": "object"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "when": {
                "type": "string",
                "description": "Branch label emitted by the source node"
              }
            }
          }
        }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "object",
          "description": "Text per locale, e.g. {\"en\": \"...\", \"ar\": \"...\"}",
          "propertyNames": {
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1
        },
        "greeting": {
          "type": "object",
          "description": "Text per locale, e.g. {\"en\": \"...\", \"ar\": \"...\"}",
          "propertyNames": {
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1
        },
        "starter_questions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6
          }
        },
        "accent_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "x-ui": {
            "widget": "color"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "description": "Words the widget shows, in this domain's own vocabulary (e.g. \"Contact support\" for the handoff button)",
          "properties": {
            "open": {
              "type": "object",
              "description": "Text per locale, e.g. {\"en\": \"...\", \"ar\": \"...\"}",
              "propertyNames": {
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 80
              },
              "minProperties": 1
            },
            "placeholder": {
              "type": "object",
              "description": "Text per locale, e.g. {\"en\": \"...\", \"ar\": \"...\"}",
              "propertyNames": {
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 80
              },
              "minProperties": 1
            },
            "person": {
              "type": "object",
              "description": "Text per locale, e.g. {\"en\": \"...\", \"ar\": \"...\"}",
              "propertyNames": {
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 80
              },
              "minProperties": 1
            },
            "sources": {
              "type": "object",
              "description": "Text per locale, e.g. {\"en\": \"...\", \"ar\": \"...\"}",
              "propertyNames": {
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 80
              },
              "minProperties": 1
            },
            "send": {
              "type": "object",
              "description": "Text per locale, e.g. {\"en\": \"...\", \"ar\": \"...\"}",
              "propertyNames": {
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 80
              },
              "minProperties": 1
            }
          }
        },
        "theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "description": "Light, dark, or follow the visitor's system setting"
        },
        "transcript_email": {
          "type": "boolean",
          "description": "Visitors may email themselves a copy of the conversation"
        },
        "feedback": {
          "type": "boolean",
          "description": "Visitors may rate answers"
        }
      },
      "description": "This assistant's widget text and colour; each field overrides the Domain Pack's channels.widget."
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Safe publish (QA-02): a new version is published only after it passes an evaluation on this test set without falling behind the live version.",
      "required": [
        "enabled",
        "test_set"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "test_set": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "description": "Name of the evaluation test set"
        },
        "min_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of cases that must pass (default 0.8)"
        },
        "max_drop": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Largest allowed fall against the live version (default 0.05)"
        }
      }
    }
  }
}
