from typing import Final

from fastapi import FastAPI

from nexiqon_core.app import create_service_app
from {{ package_name }} import __version__
from {{ package_name }}.api import public_router, tenant_router
from {{ package_name }}.lifecycle import lifecycle
from {{ package_name }}.settings import ServiceSettings

SERVICE_NAME: Final = "{{ service_name }}"
PLANE: Final = "{{ plane }}"


def create_app(settings: ServiceSettings | None = None) -> FastAPI:
    settings = settings or ServiceSettings()
    return create_service_app(
        name=SERVICE_NAME,
        version=__version__,
        plane=PLANE,
        settings=settings,
        routers=[public_router],
        tenant_routers=[tenant_router],
        lifecycle=lifecycle(SERVICE_NAME),
    )
