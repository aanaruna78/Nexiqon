{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexiqon.dev/schemas/config/retrieval_profile.json",
  "title": "Retrieval profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "heading_aware",
            "token"
          ]
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "overlap_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "vector_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "keyword_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rerank": {
          "type": "boolean"
        }
      }
    },
    "small_to_big": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000
        }
      }
    },
    "summary_nodes": {
      "type": "boolean"
    },
    "min_evidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
