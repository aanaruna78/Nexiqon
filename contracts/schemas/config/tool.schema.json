{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexiqon.dev/schemas/config/tool.json",
  "title": "Tool",
  "description": "A business API the agent may call through tool-gateway. Never contains raw secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "kind",
    "input_schema",
    "risk_level"
  ],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 5
    },
    "kind": {
      "enum": [
        "rest",
        "approval"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "url_template",
        "host_allowlist"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url_template": {
          "type": "string",
          "pattern": "^https?://",
          "description": "Path placeholders {name} come from arguments; {caller.actor_id} and {caller.tenant_id} only from the verified caller. http:// is refused outside development."
        },
        "host_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Hosts this tool may reach; the URL's host must be one of them"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "not": {
              "pattern": "(?i)(bearer|basic) "
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme"
          ],
          "properties": {
            "scheme": {
              "enum": [
                "bearer",
                "header",
                "basic"
              ]
            },
            "header": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$",
              "description": "Header name for scheme=header"
            }
          }
        },
        "query_params": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Arguments sent as query parameters even for POST/PUT/PATCH (others go in the JSON body)"
        }
      }
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "credential_ref": {
      "type": "string",
      "pattern": "^secret://[a-z0-9][a-z0-9-]{1,62}$",
      "description": "Name of a credential stored for this workspace (resolved only inside tool-gateway)"
    },
    "risk_level": {
      "enum": [
        "read",
        "write",
        "high"
      ]
    },
    "confirmation": {
      "enum": [
        "never",
        "always",
        "write_only"
      ]
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "rate_limit_per_minute": {
      "type": "integer",
      "minimum": 1
    },
    "idempotent": {
      "type": "boolean"
    },
    "result_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "description": "Sensitivity of results (decides which models may see them)"
    },
    "max_result_bytes": {
      "type": "integer",
      "minimum": 256,
      "maximum": 65536
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rest"
          }
        }
      },
      "then": {
        "required": [
          "request"
        ]
      }
    }
  ]
}
