{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexiqon.dev/schemas/cloudevent-envelope.json",
  "title": "Nexiqon CloudEvent envelope",
  "description": "Every event on the bus (NATS subject = type). Produced by nexiqon_core.events.OutboxMixin.to_cloudevent(); delivered at least once, de-duplicated by id.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "time",
    "nexiqontenantid",
    "nexiqonactorid",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "pattern": "^nexiqon\\.[a-z-]+\\.[a-z_]+\\.[a-z_]+$"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "nexiqontenantid": {
      "type": "string",
      "format": "uuid"
    },
    "nexiqonactorid": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
      "description": "W3C trace context of the producing request (CloudEvents distributed tracing extension)"
    }
  },
  "additionalProperties": false
}
