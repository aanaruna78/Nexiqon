{
  "components": {
    "schemas": {
      "ContextEcho": {
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "actor_type": {
            "title": "Actor Type",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "actor_id",
          "actor_type"
        ],
        "title": "ContextEcho",
        "type": "object"
      },
      "GraphCheck": {
        "properties": {
          "problems": {
            "items": {
              "type": "string"
            },
            "title": "Problems",
            "type": "array"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "valid",
          "problems"
        ],
        "title": "GraphCheck",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Message": {
        "properties": {
          "content": {
            "maxLength": 20000,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "Message",
        "type": "object"
      },
      "RunIn": {
        "properties": {
          "history": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "maxItems": 50,
            "title": "History",
            "type": "array"
          },
          "input": {
            "anyOf": [
              {
                "maxLength": 8000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input"
          },
          "locale": {
            "default": "en",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "title": "Locale",
            "type": "string"
          },
          "resume": {
            "title": "Resume"
          },
          "thread_id": {
            "pattern": "^[A-Za-z0-9._:-]{1,100}$",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id"
        ],
        "title": "RunIn",
        "type": "object"
      },
      "RunOut": {
        "properties": {
          "answer": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "handoff": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handoff"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "interrupt": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interrupt"
          },
          "retention_profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retention Profile"
          },
          "route": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "steps": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "status",
          "answer",
          "interrupt",
          "handoff",
          "intent",
          "route",
          "steps",
          "error",
          "retention_profile"
        ],
        "title": "RunOut",
        "type": "object"
      },
      "RunTrace": {
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "agent_versions": {
            "additionalProperties": true,
            "title": "Agent Versions",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "steps": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Steps",
            "type": "array"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "thread_id",
          "agent",
          "agent_versions",
          "kind",
          "status",
          "steps",
          "result",
          "error",
          "created_at",
          "finished_at"
        ],
        "title": "RunTrace",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "nexiqon-agent-runtime",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/meta": {
      "get": {
        "operationId": "meta_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Meta Meta Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Meta",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/agents/{agent}/runs": {
      "post": {
        "description": "Run one turn of an agent on a thread, or resume it after a clarifying question/approval.",
        "operationId": "run_agent_v1_agents__agent__runs_post",
        "parameters": [
          {
            "in": "path",
            "name": "agent",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
              "title": "Agent",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Agent",
        "tags": [
          "agent-runtime"
        ]
      }
    },
    "/v1/context": {
      "get": {
        "description": "Echo the verified tenant context (used by isolation smoke tests).",
        "operationId": "context_v1_context_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextEcho"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Context",
        "tags": [
          "agent-runtime"
        ]
      }
    },
    "/v1/graphs/validate": {
      "post": {
        "description": "Check a declarative graph before publishing it (Domain Pack editor, agent overrides).",
        "operationId": "validate_v1_graphs_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Graph",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphCheck"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Validate",
        "tags": [
          "agent-runtime"
        ]
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "description": "A run's step-by-step trace (Answer Inspector). Callers see their own runs; staff see all.",
        "operationId": "get_run_v1_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunTrace"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run",
        "tags": [
          "agent-runtime"
        ]
      }
    },
    "/v1/threads/{thread_id}/runs": {
      "get": {
        "operationId": "thread_runs_v1_threads__thread_id__runs_get",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "title": "Thread Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunTrace"
                  },
                  "title": "Response Thread Runs V1 Threads  Thread Id  Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Thread Runs",
        "tags": [
          "agent-runtime"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/agent-runtime"
    }
  ]
}
