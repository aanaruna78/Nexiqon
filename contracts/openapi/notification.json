                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Webhooks",
        "tags": [
          "notification"
        ]
      },
      "post": {
        "description": "Send matching events to your endpoint, signed with a secret shown only now.",
        "operationId": "create_webhook_v1_webhooks_post",
        "requestBody": {
          "content": {
