        "type": "object"
      },
      "WebhookIn": {
        "properties": {
          "description": {
            "default": "",
            "maxLength": 200,
            "title": "Description",
            "type": "string"
          },
          "events": {
            "items": {
              "pattern": "^[a-z][a-z0-9_.*-]{1,120}$",
              "type": "string"
            },
            "maxItems": 50,
            "title": "Events",
            "type": "array"
          },
          "url": {
            "maxLength": 2000,
            "pattern": "^https?://",
