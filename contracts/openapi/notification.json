        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Link"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "read": {
            "title": "Read",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "params",
          "link",
          "created_at",
          "read"
        ],
        "title": "InboxOut",
        "type": "object"
      },
      "ReadIn": {
        "properties": {
          "ids": {
            "items": {
