  "info": {
    "title": "nexiqon-notification",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/meta": {
      "get": {
        "operationId": "meta_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Meta Meta Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Meta",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/context": {
      "get": {
        "description": "Echo the verified tenant context (used by isolation smoke tests).",
        "operationId": "context_v1_context_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextEcho"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Context",
        "tags": [
          "notification"
        ]
      }
    },
    "/v1/emails": {
      "post": {
        "description": "Send one email for a platform service and log the delivery (without the address).",
        "operationId": "send_email_v1_emails_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send Email",
        "tags": [
          "notification"
        ]
      }
    },
    "/v1/inbox": {
      "get": {
        "description": "What needs your attention, for your roles in this organization.",
        "operationId": "inbox_v1_inbox_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inbox"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Inbox",
        "tags": [
          "notification"
        ]
      }
    },
