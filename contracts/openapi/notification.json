{
  "components": {
    "schemas": {
      "ContextEcho": {
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "actor_type": {
            "title": "Actor Type",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "actor_id",
          "actor_type"
        ],
        "title": "ContextEcho",
        "type": "object"
      },
      "DeliveryOut": {
        "properties": {
          "id": {
