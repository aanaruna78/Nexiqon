            "title": "Next Attempt At"
          },
          "response_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Status"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "event_type",
          "status",
          "attempts",
          "response_status",
          "error",
          "created_at",
          "next_attempt_at"
        ],
        "title": "DeliveryRow",
        "type": "object"
      },
      "EmailIn": {
        "properties": {
          "kind": {
            "pattern": "^[a-z][a-z0-9_.-]{1,62}$",
            "title": "Kind",
            "type": "string"
          },
          "reference": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          },
          "subject": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          },
          "text": {
            "maxLength": 200000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "to": {
            "maxLength": 320,
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "to",
          "subject",
          "text",
          "kind"
        ],
        "title": "EmailIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Inbox": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/InboxOut"
            },
            "title": "Items",
            "type": "array"
          },
          "unread": {
            "title": "Unread",
            "type": "integer"
          }
        },
        "required": [
          "unread",
          "items"
        ],
        "title": "Inbox",
        "type": "object"
      },
