  "info": {
    "title": "nexiqon-channel",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/meta": {
      "get": {
        "operationId": "meta_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Meta Meta Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Meta",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/channels": {
      "get": {
        "description": "Channel types this deployment offers.",
        "operationId": "channels_v1_channels_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChannelInfo"
                  },
                  "title": "Response Channels V1 Channels Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Channels",
        "tags": [
          "channel"
        ]
      }
    },
    "/v1/channels/{channel}/agents/{agent}": {
      "get": {
        "description": "What a client of this channel needs to talk to the agent: for the widget, its title,\ngreeting, starter questions, theme colour and endpoints (W-00). Nothing secret: the full\nagent configuration never leaves the platform.",
        "operationId": "channel_settings_v1_channels__channel__agents__agent__get",
        "parameters": [
          {
            "in": "path",
            "name": "channel",
            "required": true,
            "schema": {
              "title": "Channel",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "agent",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
              "title": "Agent",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "default": "en",
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
              "title": "Locale",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Channel Settings V1 Channels  Channel  Agents  Agent  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Channel Settings",
        "tags": [
          "channel"
        ]
      }
    },
    "/v1/context": {
      "get": {
        "description": "Echo the verified tenant context (used by isolation smoke tests).",
        "operationId": "context_v1_context_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextEcho"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Context",
        "tags": [
          "channel"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/channel"
    }
  ]
}
