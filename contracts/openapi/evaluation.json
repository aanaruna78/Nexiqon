          }
        },
        "summary": "Context",
        "tags": [
          "evaluation"
        ]
      }
    },
    "/v1/evaluations/reports": {
      "get": {
        "description": "The latest completed scorecard per version and test set (newest version first).",
        "operationId": "reports_v1_evaluations_reports_get",
        "parameters": [
          {
            "in": "query",
            "name": "agent",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
              "title": "Agent",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "test_set_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Test Set Id"
            }
          }
        ],
        "responses": {
