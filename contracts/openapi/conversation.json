{
  "components": {
    "schemas": {
      "ApprovalIn": {
        "properties": {
          "approved": {
            "title": "Approved",
            "type": "boolean"
          }
        },
        "required": [
          "approved"
        ],
        "title": "ApprovalIn",
        "type": "object"
      },
      "ContextEcho": {
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "actor_type": {
            "title": "Actor Type",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "actor_id",
          "actor_type"
        ],
        "title": "ContextEcho",
        "type": "object"
      },
      "ConversationDetail": {
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "channel": {
            "title": "Channel",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "handoff_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handoff Summary"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_message_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Message At"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageOut"
            },
            "title": "Messages",
            "type": "array"
          },
          "retain_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retain Until"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "id",
          "agent",
          "channel",
          "locale",
          "actor_id",
          "status",
          "title",
          "handoff_summary",
          "created_at",
          "last_message_at",
          "retain_until",
          "messages"
        ],
        "title": "ConversationDetail",
        "type": "object"
      },
      "ConversationIn": {
        "properties": {
          "agent": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
            "title": "Agent",
            "type": "string"
          },
          "channel": {
            "default": "api",
            "enum": [
              "api",
              "widget",
              "studio"
            ],
            "title": "Channel",
            "type": "string"
          },
          "locale": {
            "default": "en",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "title": "Locale",
            "type": "string"
          }
        },
        "required": [
          "agent"
        ],
        "title": "ConversationIn",
        "type": "object"
      },
      "ConversationOut": {
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "channel": {
            "title": "Channel",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "handoff_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handoff Summary"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_message_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Message At"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "retain_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retain Until"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "id",
          "agent",
          "channel",
          "locale",
          "actor_id",
          "status",
          "title",
          "handoff_summary",
          "created_at",
          "last_message_at",
          "retain_until"
        ],
        "title": "ConversationOut",
        "type": "object"
      },
      "FeedbackIn": {
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "rating": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Rating",
            "type": "string"
          }
        },
        "required": [
          "rating"
        ],
        "title": "FeedbackIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MessageIn": {
        "properties": {
          "content": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "MessageIn",
        "type": "object"
      },
      "MessageOut": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "contract": {
            "additionalProperties": true,
            "title": "Contract",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "contract",
          "run_id",
          "created_at"
        ],
        "title": "MessageOut",
        "type": "object"
      },
      "TurnOut": {
        "properties": {
          "conversation": {
            "$ref": "#/components/schemas/ConversationOut"
          },
          "reply": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MessageOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "user_message": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MessageOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "conversation",
          "user_message",
          "reply"
        ],
        "title": "TurnOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "nexiqon-conversation",
